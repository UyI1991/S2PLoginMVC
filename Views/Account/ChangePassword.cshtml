@model LoginMVC.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="glass-page-bg d-flex justify-content-center align-items-start pt-5" style="min-height: calc(100vh - 58px);">
    <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-5 px-3">
        <div class="card shadow border-0 overflow-hidden">
            
            <div class="card-header bg-warning text-dark text-center py-3">
                <h4 class="mb-0 fw-bold">Cambiar Contraseña</h4>
            </div>

            <div class="card-body bg-white text-dark p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                @* Formulario AccountController para cambio de contraseña *@
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    @*Ingreso de contraseña actual*@
                    <div class="mb-3">
                        <label asp-for="ContrasenaActual" class="form-label fw-semibold">Contraseña Actual</label>
                        <div class="input-group">
                            <input asp-for="ContrasenaActual" type="password" class="form-control" />
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="inputContrasenaActual" title="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                    </div>

                    @*Ingreso de nueva contraseña*@
                    <div class="mb-3">
                        <label asp-for="NuevaContrasena" class="form-label fw-semibold">Nueva Contraseña</label>
                        <div class="input-group">
                            <input asp-for="NuevaContrasena" type="password" class="form-control" />
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="inputNuevaContrasena" title="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                    </div>

                    @*Ingreso nuevamente de nueva contraseña*@
                    <div class="mb-4">
                        <label asp-for="ConfirmarNuevaContrasena" class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
                        <div class="input-group">
                            <input asp-for="ConfirmarNuevaContrasena" type="password" class="form-control" />
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="inputConfirmarContrasena" title="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarNuevaContrasena" class="text-danger small"></span>
                    </div>

                    @*Botones de Actualizar y Cancelar*@
                    <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3 mt-4">
                        <button type="submit" class="btn btn-warning fw-semibold px-4 py-2 flex-fill rounded-pill text-nowrap">
                            <i class="bi bi-check2-circle me-1"></i> Actualizar Contraseña
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary fw-semibold px-4 py-2 text-center flex-fill rounded-pill text-nowrap">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("click", function (e) {
            const btn = e.target.closest(".toggle-password");
            if (!btn) return;

            // Busca el <input> dentro del mismo .input-group
            const inputGroup = btn.closest(".input-group");
            const passwordInput = inputGroup ? inputGroup.querySelector("input") : null;
            const icon = btn.querySelector("i");

            if (passwordInput) {
                const isPassword = passwordInput.type === "password";
                passwordInput.type = isPassword ? "text" : "password";

                if (icon) {
                    icon.classList.toggle("bi-eye");
                    icon.classList.toggle("bi-eye-slash");
                }
            }
        });
    </script>
}