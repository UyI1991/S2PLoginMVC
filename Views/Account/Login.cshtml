@model LoginMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="glass-page-bg min-vh-100 w-100">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 px-3">
        <div class="card glass-card border-0 p-4 p-sm-5 mx-auto" style="max-width: 450px; width: 100%;">
            <!-- Encabezado de la caja -->
            <div class="login-card-header">
                <i class="bi bi-shield-lock-fill fs-1 mb-2 d-block"></i>
                <h3 class="mb-1 fw-bold">Bienvenido</h3>
                <small class="mb-1 fw-bold-50">Ingresa tus credenciales para iniciar sesión</small>
            </div>

            <!-- Cuerpo del formulario -->
            <div class="card-body p-4">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="alert alert-success py-2 small">
                        <i class="bi bi-check-circle me-1"></i> @User.Identity.Name!
                    </div>
                }

                @if (TempData["MensajeExito"] != null)
                {
                        <div class="alert alert-success">@TempData["MensajeExito"]</div>
                }

				<form asp-controller="Account"
						asp-action="Login"
						method="post">
					@Html.ValidationSummary(false)

					<div class="mb-3">
						<label asp-for="Nickname" class="form-label fw-semibold text-secondary">
							<i class="bi bi-person-fill me-1"></i> Usuario 
						</label>
							<input asp-for="Nickname" class="form-control" placeholder="Ingresa tu nombre o usuario">
						<span asp-validation-for="Nickname" class="text-danger small"></span>
					</div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-key-fill me-1"></i> Contraseña
                        </label>
                        <div class="input-group">
                            <input asp-for="Contrasena" type="password" class="form-control" placeholder="********" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePass(this)" title="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye" id="togglePassword"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

					<button type="submit" class="btn btn-primary w-100">
						Iniciar Sesión <i class="bi bi-box-arrow-in-right ms-1"></i>
					</button>
				</form>
			</div>
			<div class="card-footer text-center d-flex flex-column align-items-center py-3">
				<a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm">
				Registrar nuevo usuario</a>
				<small class="text-muted mt-2">
					Universidad Panamericana
				</small>
			</div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Script de Alternancia de Contraseña Visible -->
    
}
