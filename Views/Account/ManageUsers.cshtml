@model IEnumerable<LoginMVC.Models.Usuario>
@{
    ViewData["Title"] = "Administrar Usuarios";
}

<div class="glass-page-bg d-flex justify-content-center align-items-start pt-5" style="min-height: calc(100vh - 58px);">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 px-3">
        <div class="card shadow border-0 overflow-hidden">

            <!-- Encabezado verde -->
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
                <h4 class="mb-0">Panel de Super Admin - Usuarios Registrados</h4>
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-warning d-inline-flex align-items-center gap-1 px-3 py-1 small text-nowrap fw-semibold">
                    Volver al Panel Principal
                </a>
            </div>

            <!-- Cuerpo blanco con la tabla -->
            <div class="card-body bg-white text-black p-4">
                @if (TempData["ExitoAdmin"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["ExitoAdmin"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorAdmin"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        @TempData["ErrorAdmin"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Usuario (Nickname)</th>
                                <th>Rol</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                bool esAdmin = item.Nickname.Equals("admin", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td>@item.IdUsuario</td>
                                    <td class="fw-bold">@item.Nickname</td>
                                    <td>
                                        @if (esAdmin)
                                        {
                                            <span class="badge bg-primary">Super Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Usuario</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!esAdmin)
                                        {
                                            <form asp-controller="Account" asp-action="DeleteUser" method="post" class="m-0"
                                                  onsubmit="return confirm('¿Estás seguro de eliminar al usuario @item.Nickname?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.IdUsuario" />
                                                <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                                    Eliminar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Disponible</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>