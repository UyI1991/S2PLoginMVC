@model LoginMVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registrar Nuevo Usuario";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="glass-page-bg min-vh-100 w-100">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 px-3">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-5">
                    <div class="card shadow">
                        <div class="card-header bg-success text-white text-center">
                            <h3>Crear Cuenta</h3>
                        </div>
                        <div class="card-body">
                            <form asp-controller="Account" asp-action="Register" method="post">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label asp-for="Nickname" class="form-label">Usuario (Nickname)</label>
                                    <input asp-for="Nickname" class="form-control" placeholder="Ej. Password" />
                                    <span asp-validation-for="Nickname" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Contrasena" class="form-label">Contraseña</label>
                                    <div class="input-group">
                                        <input asp-for="Contrasena" type="password" class="form-control" placeholder="Mínimo 8 caracteres" />
                                        <button class="btn btn-outline-secondary" type="button" onclick="togglePass(this)" title="Mostrar u ocultar contraseña">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ConfirmarContrasena" class="form-label">Confirmar Contraseña</label>
                                    <div class="input-group">
                                        <input asp-for="ConfirmarContrasena" type="password" class="form-control" placeholder="Repite tu contraseña" />
                                        <button class="btn btn-outline-secondary" type="button" onclick="togglePass(this)" title="Mostrar u ocultar contraseña">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
                                    <button type="submit" class="btn btn-success w-100  rounded-pill">Registrar Usuario</button>
                                </div>
                            </form>
                        </div>
                    </div>        
                    <div class="text-center">
                        <span class="text-white-50">¿Ya tienes cuenta?</span>
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none">
                            <span class="fw-bold text-decoration-underline">Inicia sesión aquí</span>
                        </a>
                    </div>   
                </div>            
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}